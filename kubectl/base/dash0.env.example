# =============================================================================
# Dash0 SignalControl on the edge - the only file you edit
# =============================================================================
#   cp dash0.env.example dash0.env
#
# Plain KEY=VALUE. No quotes, no spaces around `=`, no shell expansion.
# =============================================================================

# Your Dash0 region, exactly as it appears in your Dash0 URL.
DASH0_REGION=eu-west-1

# The Dash0 environment your organisation lives in. Change this only if Dash0
# gives you a different domain.
DASH0_DOMAIN=aws.dash0.com

# REQUIRED, and deliberately empty. The dataset your sampling rules live in: it
# must already exist in Dash0, and it must be the dataset the rules were created
# in.
#
# There is no working default on purpose. A plausible placeholder would give you
# a fully Ready install whose rules never match anything. Left empty, the
# collector refuses to start and says so:
#
#   error with key "dash0.dataset" (1-th action): error creating AttrProc.
#   Either field "value", "from_attribute", "from_context", or "default_value"
#   must be specified
DASH0_DATASET=

# -----------------------------------------------------------------------------
# The three endpoints are derived from DASH0_REGION and DASH0_DOMAIN:
#
#   Dash0 API        https://api.<region>.<domain>
#   OTLP ingress     ingress.<region>.<domain>:4317
#   Decision-Maker   decision-maker.<region>.<domain>:443
#
# Retargeting all three is one value, DASH0_DOMAIN.
#
# If your Dash0 hosts do not follow that pattern, uncomment ALL THREE keys
# below, set them, and apply the endpoints overlay instead:
#
#   kubectl apply -k endpoints
#
# All three or none. The overlay reads all three, so a key left commented out
# stops the pods with `CreateContainerConfigError: couldn't find key ... in
# ConfigMap` rather than starting them against a half-wrong endpoint.
# -----------------------------------------------------------------------------

# DASH0_ENDPOINT_API=https://api.eu-west-1.aws.dash0.com
# DASH0_ENDPOINT_OTLP=ingress.eu-west-1.aws.dash0.com:4317
# DASH0_ENDPOINT_DECISION_MAKER=decision-maker.eu-west-1.aws.dash0.com:443
